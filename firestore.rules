rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for MLBGame records
    function isValidGame(game) {
      return game.id is string
        && game.metadata is map
        && game.teams is map
        && game.pitchers is map
        && game.bullpen is map
        && game.offense is map
        && game.trends is map
        && game.betting_lines is map
        && game.timestamp is string;
    }

    // Matches for games collection
    match /games/{gameId} {
      allow get: if isSignedIn() && isValidId(gameId);
      allow list: if isSignedIn() && resource.data.timestamp is string;
      
      allow create: if isSignedIn() 
        && isValidId(gameId) 
        && isValidGame(incoming())
        && incoming().id == gameId;
        
      allow update: if isSignedIn()
        && isValidId(gameId)
        && isValidGame(incoming())
        && incoming().id == existing().id;
        
      allow delete: if isSignedIn() && isValidId(gameId);
    }

    // Bet tracking data grouped by date, for example mlb_bets/2026-06-17.
    match /mlb_bets/{dateId} {
      allow read: if isSignedIn() && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$');
      allow create, update: if isSignedIn()
        && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && incoming().bets is list
        && incoming().bets.size() <= 500;
      allow delete: if isSignedIn() && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // Registered bet-tracking users live in mlb_users/registered.
    match /mlb_users/{userDoc} {
      allow read: if isSignedIn() && userDoc == 'registered';
      allow create, update: if isSignedIn()
        && userDoc == 'registered'
        && incoming().list is list
        && incoming().list.size() <= 200;
      allow delete: if isSignedIn() && userDoc == 'registered';
    }
  }
}
