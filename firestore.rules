rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for MLBGame records
    function isValidGame(game) {
      return game.id is string
        && game.metadata is map
        && game.teams is map
        && game.pitchers is map
        && game.bullpen is map
        && game.offense is map
        && game.trends is map
        && game.betting_lines is map
        && game.timestamp is string;
    }

    // Matches for games collection
    match /games/{gameId} {
      allow get: if isSignedIn() && isValidId(gameId);
      // Sept. 2026 — antes exigía "&& resource.data.timestamp is string" acá.
      // Un `list` (consulta con where(), no un get puntual) evalúa esta condición
      // contra CADA documento que la consulta devolvería — si uno solo de los
      // documentos existentes (por ejemplo, de fechas históricas) no tiene
      // `timestamp` guardado como string, Firestore no lo filtra: rechaza la
      // consulta ENTERA con permission-denied, sin indicar cuál documento falló.
      // Esto rompía loadGamesByDateFromFirestore y loadGamesByDateRangeFromFirestore
      // por completo. Se saca esa condición — mismo nivel de exigencia que `get`.
      allow list: if isSignedIn();

      allow create: if isSignedIn() 
        && isValidId(gameId) 
        && isValidGame(incoming())
        && incoming().id == gameId;
        
      allow update: if isSignedIn()
        && isValidId(gameId)
        && isValidGame(incoming())
        && incoming().id == existing().id;
        
      allow delete: if isSignedIn() && isValidId(gameId);
    }

    // Sept. 2026 — encontrado probando la app en vivo: saveGameData (firestoreService.ts)
    // escribe 3 cosas por juego — el doc principal en games/{gameId} (cubierto arriba),
    // un snapshot histórico en games/{gameId}/snapshots/{timestamp}, y el documento
    // liviano metadata/extracted_dates (con arrayUnion de fechas) — pero SOLO el
    // primero tenía una regla. Los otros dos caían en el "Global Safety Net" (niega
    // todo por default) y fallaban con PERMISSION_DENIED en cada guardado, sin
    // frenar la extracción (el doc principal sí se guardaba) pero disparando 3
    // reintentos con backoff por juego en saveGameDataReliably — esto es lo que se
    // sentía como que la extracción se quedaba "enganchada".
    match /games/{gameId}/snapshots/{snapshotId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isSignedIn();
    }
    match /metadata/{docId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Bet tracking data grouped by date, for example mlb_bets/2026-06-17.
    match /mlb_bets/{dateId} {
      allow read: if isSignedIn() && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$');
      allow create, update: if isSignedIn()
        && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && incoming().bets is list
        && incoming().bets.size() <= 500;
      allow delete: if isSignedIn() && dateId.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // Registered bet-tracking users live in mlb_users/registered.
    match /mlb_users/{userDoc} {
      allow read: if isSignedIn() && userDoc == 'registered';
      allow create, update: if isSignedIn()
        && userDoc == 'registered'
        && incoming().list is list
        && incoming().list.size() <= 200;
      allow delete: if isSignedIn() && userDoc == 'registered';
    }

    // Sept. 2026 — auditoría con el usuario, punto #1: persistencia de las stats
    // point-in-time (pitcher_stats_pit.json / offense_stats_pit.json /
    // boxscore_game_stats.json) para que sobrevivan a un redeploy de Render (disco
    // efímero) igual que ya sobrevive `games`. Una colección por archivo — cada
    // documento es una entrada keyed por gameId, igual patrón que `games/{gameId}`
    // — en vez de un solo documento gigante, porque los 3 archivos combinados ya
    // pesan más de 4MB (el límite de Firestore es 1MB por documento).
    match /pit_pitchers/{gameId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(gameId);
      allow delete: if isSignedIn() && isValidId(gameId);
    }
    match /pit_offense/{gameId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(gameId);
      allow delete: if isSignedIn() && isValidId(gameId);
    }
    match /pit_boxscore/{gameId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(gameId);
      allow delete: if isSignedIn() && isValidId(gameId);
    }
  }
}
