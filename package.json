{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.mjs && node server.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "test": "npm run test:unit && npm run test:klab",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:klab": "tsx src/utils/lineupMetrics.test.ts && tsx src/datasets/klabTrainingDataset.test.ts && tsx src/datasets/firestorePregameIdAudit.test.ts && tsx src/datasets/klabDynamicHistoryAudit.test.ts && tsx src/datasets/klabDynamicRollingFeatures.test.ts && tsx src/datasets/klabDynamicRollingExperiment.test.ts && tsx src/datasets/klabDynamicRollingMigrationAudit.test.ts && tsx src/datasets/klabDynamicRollingModelComparison.test.ts",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "tool": "tsx tool.ts",
    "klab:recover-history": "tsx src/datasets/firestorePregameHistory.ts",
    "klab:history": "tsx src/datasets/klabHistoricalMatching.ts",
    "klab:match-history": "tsx src/datasets/klabHistoricalMatching.ts",
    "klab:audit-firestore-ids": "tsx src/datasets/firestorePregameIdAudit.ts",
    "klab:audit-dynamic-history": "tsx src/datasets/klabDynamicHistoryAudit.ts",
    "klab:experiment-dynamic-rolling": "tsx src/datasets/klabDynamicRollingExperiment.ts",
    "klab:audit-dynamic-rolling-migration": "tsx src/datasets/klabDynamicRollingMigrationAudit.ts",
    "klab:audit-dynamic-rolling": "tsx src/datasets/klabDynamicRollingAudit.ts",
    "klab:compare-dynamic-rolling": "tsx src/datasets/klabDynamicRollingAudit.ts",
    "klab:compare-dynamic-rolling-models": "tsx src/datasets/klabDynamicRollingModelComparison.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.18.0",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.14.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "whatwg-url": "^16.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.16.2",
    "typescript": "~5.8.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  }
}
